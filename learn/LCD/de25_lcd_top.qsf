set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_sda -entity de25_lcd_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_dc -entity de25_lcd_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_cs -entity de25_lcd_top
set_global_assignment -name VERILOG_FILE rtl/st7789_driver.v
set_location_assignment PIN_V16 -to clk -comment IOBANK_6C
set_location_assignment PIN_Y2 -to lcd_rst -comment IOBANK_6D
set_location_assignment PIN_H16 -to lcd_sck -comment IOBANK_6C
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_rst -entity de25_lcd_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk -entity de25_lcd_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_sck -entity de25_lcd_top
set_location_assignment PIN_C8 -to rst_n -comment IOBANK_6D
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to rst_n -entity de25_lcd_top
